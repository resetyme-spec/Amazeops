{
 "name": "amazefab-marketplace-functions",
 "version": "1.0.0",
 "description": "AmazeFab Marketplace — Firebase Cloud Functions",
 "main": "lib/index.js",
 "scripts": {
  "build": "tsc",
  "watch": "tsc --watch",
  "serve": "npm run build && firebase emulators:start --only functions",
  "shell": "npm run build && firebase functions:shell",
  "start": "npm run shell",
  "logs": "firebase functions:log",
  "lint": "eslint --ext .js,.ts ."
 },
 "engines": {
  "node": "22"
 },
 "dependencies": {
  "@types/markdown-it": "^14.2.0",
  "acorn": "^8.19.0",
  "firebase-admin": "^11.11.0",
  "firebase-functions": "^4.9.0",
  "markdown-it": "^15.0.3",
  "zod": "^3.22.4"
 },
 "devDependencies": {
  "@types/node": "^20.11.24",
  "typescript": "^5.3.3"
 }
}
